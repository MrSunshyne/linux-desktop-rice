pragma Singleton
// User choices from the Control Center's Settings tab, saved to
// ~/.config/quickshell/settings.json (edits on disk are picked up live).
//
// Also keeps two things outside Quickshell in sync:
//   ~/.config/hypr/look.lua            generated values hyprland.lua reads
//                                      (border colours, glass, bar shape, animations)
//   ~/.local/state/quickshell/wallpaper  symlink to the wallpaper, used by hyprlock
import QtQuick
import Quickshell
import Quickshell.Io
import "themes.js" as Themes

Singleton {
    id: root

    // Defaults match the look before the Settings tab existed.
    property alias flavour: json.flavour          // theme id from themes.js (mocha, nord, gruvbox, …)
    property alias accent: json.accent            // accent name; falls back to the theme's default
    property alias material: json.material        // glass | solid
    property alias frost: json.frost              // hyprglass blur_strength
    property alias refraction: json.refraction    // hyprglass refraction_strength
    property alias tint: json.tint                // glass tint opacity, 0..1
    property alias barFloating: json.barFloating
    property alias barHeight: json.barHeight
    property alias roundness: json.roundness      // panel corner radius, px
    property alias motion: json.motion            // off | fast | normal | relaxed
    property alias wallpaper: json.wallpaper      // absolute path; "" = GNOME's
    property alias dockEnabled: json.dockEnabled
    property alias dockAutohide: json.dockAutohide
    property alias dockPosition: json.dockPosition // bottom | left | right
    property alias dockIconSize: json.dockIconSize
    property alias dockMagnification: json.dockMagnification   // max hover scale, 1 = off
    property alias dockPinned: json.dockPinned    // desktop entry ids, in order

    function isPinned(id) { return dockPinned.includes(id); }
    function togglePin(id) {
        dockPinned = isPinned(id) ? dockPinned.filter(p => p !== id) : [...dockPinned, id];
    }

    readonly property string home: Quickshell.env("HOME")
    readonly property string gnomeWallpaper: home + "/.config/background"
    readonly property string wallpaperPath: wallpaper !== "" ? wallpaper : gnomeWallpaper

    FileView {
        id: settingsFile
        path: root.home + "/.config/quickshell/settings.json"
        blockLoading: true            // values must exist before windows are built
        watchChanges: true
        onFileChanged: reload()
        onAdapterUpdated: writeAdapter()
        onLoadFailed: error => { if (error === FileViewError.FileNotFound) writeAdapter(); }

        JsonAdapter {
            id: json
            property string flavour: "mocha"
            property string accent: "sapphire"
            property string material: "glass"
            property real frost: 1.4
            property real refraction: 1.6
            property real tint: 0.45
            property bool barFloating: true
            property int barHeight: 34
            property int roundness: 16
            property string motion: "normal"
            property string wallpaper: ""
            property bool dockEnabled: true
            property bool dockAutohide: false
            property string dockPosition: "bottom"
            property int dockIconSize: 48
            property real dockMagnification: 1.6
            property list<string> dockPinned: [
                "org.gnome.Nautilus", "google-chrome", "org.mozilla.firefox", "herdr-app",
                "cursor", "com.mitchellh.ghostty", "net.thunderbird.Thunderbird", "com.spotify.Client",
            ]
        }
    }

    // ---- Hyprland side ------------------------------------------------------

    function hex(c) { return c.replace("#", ""); }
    function alphaHex(a) { return ("0" + Math.round(Math.max(0, Math.min(1, a)) * 255).toString(16)).slice(-2); }

    readonly property string lookText: {
        const f = Themes.get(flavour);
        const c = f.colors;
        const a = Themes.accentOf(f, accent);
        // Border gradient: accent → the accent before it in the theme's list
        // (the first pairs with the second).
        const i = f.accents.indexOf(a);
        const partner = f.accents[i === 0 ? 1 : i - 1];
        const radius = barFloating ? Math.min(roundness, Math.floor(barHeight / 2)) : 0;
        return [
            "-- Generated by the Quickshell Settings tab (~/.config/quickshell/Settings.qml).",
            "-- Change values there; edits here are overwritten.",
            "return {",
            `    dark = ${f.dark},`,
            `    accent = "${hex(c[a])}",`,
            `    accent2 = "${hex(c[partner])}",`,
            `    inactive = "${hex(c.surface1)}",`,
            `    tint = "${hex(c.crust)}${alphaHex(tint)}",`,
            `    glass = ${material === "glass"},`,
            `    frost = ${frost.toFixed(2)},`,
            `    refraction = ${refraction.toFixed(2)},`,
            `    bar_floating = ${barFloating},`,
            `    bar_radius = ${radius},`,
            `    animations = ${motion !== "off"},`,
            "}",
            "",
        ].join("\n");
    }

    FileView {
        id: lookFile
        path: root.home + "/.config/hypr/look.lua"
        printErrors: false            // missing on first run
        blockWrites: true             // written before `hyprctl reload` runs, or Hyprland reads the old file
        onLoaded: lookSync.restart()
        onLoadFailed: lookSync.restart()
    }

    // Debounced: dragging a slider shouldn't reload Hyprland on every step.
    onLookTextChanged: lookSync.restart()
    Timer {
        id: lookSync
        interval: 400
        onTriggered: {
            if (lookFile.loaded && lookFile.text() === root.lookText) return;
            lookFile.setText(root.lookText);
            hyprReload.running = true;
        }
    }
    Process { id: hyprReload; command: ["hyprctl", "reload"] }

    // ---- Lock screen wallpaper ---------------------------------------------

    // Pass the path explicitly: a bound `command` can still hold the old path
    // when this handler runs.
    function linkWallpaper(path) {
        Quickshell.execDetached(["sh", "-c", 'mkdir -p "$HOME/.local/state/quickshell" && ln -sfn "$1" "$HOME/.local/state/quickshell/wallpaper"', "sh", path]);
    }
    onWallpaperPathChanged: linkWallpaper(wallpaperPath)
    Component.onCompleted: linkWallpaper(wallpaperPath)
}
